# Database Configuration (PostgreSQL Docker container)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=jain_matrimony

# JWT Secret
JWT_SECRET=super-secret-jain-matrimony-key

# WhatsApp Cloud API (Meta Graph API) Integration
# Get these credentials from https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=your_meta_system_user_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_USE_TEMPLATE=false
WHATSAPP_TEMPLATE_NAME=jain_matrimony_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Development / Testing Bypass
# Set to true to permit dev bypass OTP (123456)
ALLOW_DEV_OTP=true

# Firebase Cloud Messaging (FCM) / Firebase Admin SDK
# Obtain service account JSON credentials from Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"


